# Server
PORT=3000
CORS_ORIGIN=*

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=happy
DB_SYNCHRONIZE=false

# Auth
JWT_SECRET=change-me
AUTH_USERNAME=authuser
AUTH_PASSWORD=

# Notes
# - DB_* variables are required for the app to reach the database
#   (checked at startup; see EnvValidationService)
# - Health check endpoint: GET /api/v1/health
# - Swagger UI: /api/docs (JSON at /api/docs-json)